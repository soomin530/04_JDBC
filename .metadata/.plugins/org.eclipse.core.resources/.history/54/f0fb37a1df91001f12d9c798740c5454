<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>

	<!-- 화면 구성 -->
	
	<!--  
		 1. 메인페이지 
		 - 등록되어있는 모든 학생 목록 출력
		 - 학생 목록에서 이름 클릭 시 학생 상세조회 화면 이동
		 - 학생 추가 버튼 (클릭 시 학생 추가 화면 이동) 
	-->
	<entry key="todoListFullView">
		SELECT STD_NO, STD_NAME, STD_AGE, STD_GENDER
		FROM TB_STUDENT
		WHERE STD_NO > 0
		ORDER BY STD_NO ASC; <!-- 세미콜론 있으면 안 됨 !! -->
	</entry>

	<!--  
		  2. 상세조회 화면
		  - 선택된 학생에 대한 상세 정보 출력(이름/나이/성별/성적)
		  - 목록으로 버튼
		  - 수정 버튼 (클릭 시 수정 화면으로 이동)
		  - 삭제 버튼 (성공 시 메인페이지로, 실패 시 상세조회 화면으로)
	-->
	<entry key="getCompleteCount">
		SELECT STD_NO, STD_NAME, STD_AGE, STD_GENDER, STD_SCORE
		FROM TB_STUDENT
		WHERE STD_NO > 0
		ORDER BY STD_NO ASC;
	</entry>

	<!-- 할 일 추가 -->
	<entry key="todoAdd"> <!-- key와 = 사이에 공백 없게 하기. 안 그러면 에러가 나요 -->
		INSERT INTO TB_TODO
		VALUES(SEQ_TODO_NO.NEXTVAL, ?, ?, DEFAULT, DEFAULT)
	</entry>

	<!-- 할 일 상세 조회 -->
	<entry key="todoDetailView">
		SELECT TODO_NO, TODO_TITLE, TODO_DETAIL,
		TODO_COMPLETE,
		TO_CHAR(REG_DATE, 'YYYY-MM-DD HH24:MI:SS')REG_DATE
		FROM
		TB_TODO
		WHERE TODO_NO = ?
	</entry>

	<!-- 완료 여부 변경 TODO_COMPLETE 값이 0일 때 1로 변경, 그 외의 값(1일 때)은 0으로 변경 TODO_COMPLETE 
		에 저장되는 값이 0 또는 1만 가능(CHECK 제약조건)하기 때문에 1. DECODE(TODO_COMPLETE, 0, 1, 0) 
		-> 0은 1로 바꾸고 그 외는 0 2. DECODE(TODO_COMPLETE, 0, 1, 1, 0) -> 0은 1로 바꾸고 1은 
		0으로 둘 중 아무거나 써도 똑같이 동작함! -->
	<entry key="todoComplete">
		UPDATE TB_TODO
		SET TODO_COMPLETE =
		DECODE(TODO_COMPLETE, 0, 1, 0)
		WHERE TODO_NO = ?
	</entry>


	<!-- 할 일 수정 -->
	<entry key="todoUpdate">
		UPDATE TB_TODO
		SET TODO_TITLE = ?,
		TODO_DETAIL = ?
		WHERE
		TODO_NO = ?
	</entry>

	<entry key="todoDelete">
		DELETE FROM TB_TODO
		WHERE TODO_NO = ?
	</entry>

</properties>
